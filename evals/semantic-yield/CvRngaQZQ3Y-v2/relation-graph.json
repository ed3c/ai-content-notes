      "artifact_sha256": "sha256:304e9a058721298f7498906d2539fdabdac515f2304645d52824e6719bc5f9bf",
      "description": "Fine-tuning moves the economics from token cost to hardware cost; for very high inference workloads running a cluster is cheaper.",
      "locator": "timestamp:00:09:51.480..00:10:27.520",
      "source_dependency_key": "youtube-video:CvRngaQZQ3Y"
    },
    {
      "anchor_id": "EV-cvrngaqzq3y-v2-trace-reading-practice",
      "anchor_kind": "evidence",
      "artifact_id": "captions-auto-en-json",
