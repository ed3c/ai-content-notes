{
  "anchors": [
    {
      "anchor_id": "EV-cvrngaqzq3y-v2-code-vs-agent-reasoning",
      "anchor_kind": "evidence",
      "artifact_id": "captions-auto-en-json",
      "artifact_modality": "transcript",
