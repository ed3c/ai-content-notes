      "artifact_sha256": "sha256:304e9a058721298f7498906d2539fdabdac515f2304645d52824e6719bc5f9bf",
      "description": "Three outputs of trace mining: distillation and fine-tuning of a smaller model, generated evals and environments, and prepared content for human review.",
      "locator": "timestamp:00:11:03.200..00:12:45.960",
      "source_dependency_key": "youtube-video:CvRngaQZQ3Y"
    },
    {
      "anchor_id": "EV-cvrngaqzq3y-v2-token-to-hardware-cost",
      "anchor_kind": "evidence",
      "artifact_id": "captions-auto-en-json",
      "artifact_modality": "transcript",
