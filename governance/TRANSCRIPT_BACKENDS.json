{
  "schema_version": "transcript-backend-registry@1",
  "backends": [
    {
      "id": "native-youtube-evidence",
      "implementation": "tools/youtube_transcript.py",
      "role": "canonical-caption-or-authorized-asr-candidate",
      "raw_platform_caption_retained": true,
      "note_completion_authority": false
    },
    {
      "id": "ai-video-transcriber-captions",
      "repository": "wendy7756/AI-Video-Transcriber",
      "commit": "ade833b790d482f7a5c0a722c67bc33f71e9d2b5",
      "license": "Apache-2.0",
      "module": "backend/video_processor.py",
      "entrypoint": "VideoProcessor.fetch_subtitles",
      "adapter": "tools/ai_video_transcriber_adapter.py",
      "role": "review-only-caption-candidate-and-cross-backend-evaluation",
      "raw_platform_caption_retained": false,
      "note_completion_authority": false,
      "known_constraints": [
        "upstream language preference is hard-coded rather than caller-controlled",
        "upstream deletes downloaded VTT/SRT after returning Markdown",
        "upstream catches caption errors and returns a null candidate",
        "upstream timestamp rendering has whole-second precision",
        "audio fallback is disabled by this adapter"
      ]
    }
  ]
}
