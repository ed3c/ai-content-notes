{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/semantic-validator-report.schema.json",
  "title": "Deterministic semantic-yield validator report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validator_version",
    "content_id",
    "created_at",
    "input",
    "checks",
    "hg",
    "qg_subset",
    "qg_not_run",
    "overall_status",
    "failures"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic-validator-report@1"
    },
    "validator_version": {
      "const": "semantic-yield-validator@1"
    },
    "content_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "prompt_git_blob_sha1",
        "source_dependency_keys",
        "card_count",
        "card_order"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "prompt_git_blob_sha1": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_dependency_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "card_count": {
          "type": "integer",
          "minimum": 1
        },
        "card_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/check"
      }
    },
    "hg": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "$ref": "#/$defs/check"
      }
    },
    "qg_subset": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/check"
      }
    },
    "qg_not_run": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^QG-[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "overall_status": {
      "enum": [
        "PASS_WITH_DEFERRED_VISUAL_AND_PARTIAL_QG",
        "FAIL"
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "failures"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "DEFERRED"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
