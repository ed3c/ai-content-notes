{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/card-patch-v7.1.schema.json",
  "title": "Zettelkasten v7.1 Card Patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol", "prompt_git_blob_sha1", "source_digest",
    "registry_before_digest", "registry_after_digest", "operations",
    "render_order", "audit_sidecar_ref"
  ],
  "properties": {
    "schema_version": {"const": "zettelkasten-card-patch@2"},
    "protocol": {"const": "zettelkasten-v7.1-evidence-first-narrative-alive-dual-plane"},
    "prompt_git_blob_sha1": {"const": "7f3019f4b41a90728cd48a523d742c7c59721bf6"},
    "source_digest": {"$ref": "#/$defs/sha256"},
    "registry_before_digest": {"$ref": "#/$defs/sha256"},
    "registry_after_digest": {"$ref": "#/$defs/sha256"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "reason"],
            "properties": {
              "op": {"const": "NOOP"},
              "reason": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "stable_id", "canonical_key", "series", "revision", "visible_payload", "card_meta"],
            "properties": {
              "op": {"enum": ["ADD", "UPDATE"]},
              "stable_id": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9._:-]+$"},
              "canonical_key": {"type": "string", "pattern": "^[A-Z] \\| .+ \\| .+ \\| .+ \\| .+ \\| .+$"},
              "series": {"enum": ["N", "Q", "C", "D", "S", "P", "T", "R", "G", "E", "V", "X", "K"]},
              "revision": {"type": "integer", "minimum": 1},
              "visible_payload": {"type": "string", "minLength": 1},
              "card_meta": {"type": "object"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "stable_id", "revision", "reason"],
            "properties": {
              "op": {"enum": ["SUPERSEDE", "DEPRECATE"]},
              "stable_id": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9._:-]+$"},
              "revision": {"type": "integer", "minimum": 1},
              "superseded_by": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9._:-]+$"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "render_order": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9._:-]+$"},
      "uniqueItems": true
    },
    "audit_sidecar_ref": {"type": "string", "pattern": "^artifact:.+$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
