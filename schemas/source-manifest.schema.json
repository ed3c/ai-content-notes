{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/source-manifest.schema.json",
  "title": "Zettelkasten v7.1 Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "content_id", "source_set_digest",
    "locator_policy", "completeness", "sources", "artifact_boundaries",
    "injection_findings", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "zettelkasten-source-manifest@2"},
    "manifest_id": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "minLength": 1},
    "source_set_digest": {"$ref": "#/$defs/sha256"},
    "locator_policy": {"const": "SOURCE_THEN_HEADING_THEN_TEXT_MATCH_THEN_MISSING"},
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed", "missing_spans"],
      "properties": {
        "status": {"enum": ["complete", "partial", "blocked", "needs-review"]},
        "reviewed": {"type": "boolean"},
        "missing_spans": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "source_type", "source_dependency_key",
          "primary_or_secondary", "digest", "locators"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["transcript", "article", "paper", "code", "log", "issue", "interview", "dataset", "observation"]},
          "source_dependency_key": {"type": "string", "minLength": 1},
          "primary_or_secondary": {"enum": ["primary", "secondary", "unknown"]},
          "digest": {"$ref": "#/$defs/sha256"},
          "locators": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(page|line|timestamp|section|heading|path|commit|TEXT_MATCH|LOCATOR_MISSING)(:|::)?.*$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "artifact_boundaries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "role", "digest"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["subject-matter-source", "prompt", "evaluation-fixture", "candidate-output", "registry", "prior-state"]},
          "digest": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "injection_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator", "text_match", "disposition"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "text_match": {"type": "string", "minLength": 1},
          "disposition": {"const": "ISOLATED_AS_DATA"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
