{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/youtube-transcript-manifest.schema.json",
  "title": "YouTube transcript acquisition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "status",
    "video",
    "authorization",
    "acquisition",
    "validation",
    "artifacts",
    "authority",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "youtube-transcript-manifest@1"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "youtube_transcript.py"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "needs-review",
        "blocked"
      ]
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_url",
        "title",
        "channel",
        "channel_id",
        "duration_seconds",
        "published_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{6,20}$"
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rights_basis",
        "rights_reference",
        "attested_by",
        "attested_at"
      ],
      "properties": {
        "rights_basis": {
          "enum": [
            "owned",
            "licensed",
            "creator-permission",
            "public-domain",
            "user-provided-media",
            "user-directed-evaluation"
          ]
        },
        "rights_reference": {
          "type": "string",
          "minLength": 1
        },
        "attested_by": {
          "type": "string",
          "minLength": 1
        },
        "attested_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "description": "Which lane the acquisition took. unverified-evaluation-only may retrieve a caption track only.",
          "enum": [
            "verified",
            "unverified-evaluation-only"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unverified-evaluation-only"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "rights_basis": {
                "const": "user-directed-evaluation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "rights_basis": {
                "not": {
                  "const": "user-directed-evaluation"
                }
              }
            }
          }
        }
      ]
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_mode",
        "backend",
        "caption_kind",
        "language",
        "source_format",
        "retrieved_at",
        "raw_source",
        "source_audio_retained",
        "asr"
      ],
      "properties": {
        "requested_mode": {
          "enum": [
            "captions",
            "asr",
            "auto"
          ]
        },
        "backend": {
          "enum": [
            "yt-dlp-captions",
            "faster-whisper",
            null
          ]
        },
        "caption_kind": {
          "enum": [
            "manual",
            "automatic",
            null
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "raw_source": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "source_audio_retained": {
          "type": "boolean"
        },
        "asr": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "model",
                "model_revision",
                "device",
                "compute_type",
                "beam_size",
                "word_timestamps",
                "vad_filter",
                "condition_on_previous_text",
                "hallucination_silence_threshold",
                "glossary_sha256",
                "detected"
              ]
            }
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_count",
        "word_count",
        "character_count",
        "timestamps_monotonic",
        "timeline_coverage_ratio",
        "end_coverage_ratio",
        "maximum_end_seconds",
        "warnings",
        "quality_grade",
        "human_review_required"
      ],
      "properties": {
        "cue_count": {
          "type": "integer",
          "minimum": 0
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "character_count": {
          "type": "integer",
          "minimum": 0
        },
        "timestamps_monotonic": {
          "type": "boolean"
        },
        "timeline_coverage_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "end_coverage_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maximum_end_seconds": {
          "type": "number",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_grade": {
          "enum": [
            "manual-caption",
            "platform-auto-caption",
            "asr-unreviewed",
            "blocked"
          ]
        },
        "human_review_required": {
          "const": true
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_complete_note",
        "may_raise_claim_evidence",
        "may_enable_skill_routing"
      ],
      "properties": {
        "may_complete_note": {
          "const": false
        },
        "may_raise_claim_evidence": {
          "const": false
        },
        "may_enable_skill_routing": {
          "const": false
        }
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs-review"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "validation": {
            "properties": {
              "cue_count": {
                "minimum": 1
              },
              "timestamps_monotonic": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "quality_grade": {
                "const": "blocked"
              }
            }
          }
        }
      }
    }
  ]
}
