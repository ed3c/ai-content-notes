{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/product-signal.schema.json",
  "title": "Product signal export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_set_id", "source_binding", "claims_digest", "evidence_digest", "contradictions_digest", "signals", "unresolved_contradictions", "unknown_claims", "evidence_state", "decision", "authority_ceiling", "non_claims", "product_signal_digest"],
  "properties": {
    "schema_version": {"const": "product-signal@1"},
    "signal_set_id": {"type": "string", "minLength": 3},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_digest", "registry_digest", "dependency_key"],
      "properties": {
        "source_id": {"type": "string", "minLength": 3},
        "source_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "registry_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "dependency_key": {"type": "string", "minLength": 3}
      }
    },
    "claims_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "contradictions_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_id", "signal_class", "title", "claim_ids", "open_gaps", "authority_ceiling"],
        "properties": {
          "signal_id": {"type": "string", "pattern": "^signal:[a-z0-9][a-z0-9._:-]*$"},
          "signal_class": {"enum": ["SOURCE_PATTERN", "MECHANISM_HYPOTHESIS", "VALIDATION_GAP", "PRODUCT_WORKFLOW", "MARKET_GAP", "CONTRADICTION_SIGNAL"]},
          "title": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^claim:[a-z0-9][a-z0-9._:-]*$"}},
          "open_gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authority_ceiling": {"const": "SOURCE_EVIDENCE_ONLY"}
        }
      }
    },
    "unresolved_contradictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^contradiction:[a-z0-9][a-z0-9._:-]*$"}},
    "unknown_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^claim:[a-z0-9][a-z0-9._:-]*$"}},
    "evidence_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "runtime", "user", "paid", "legal"],
      "properties": {
        "source": {"const": "PASS"},
        "runtime": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]},
        "user": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]},
        "paid": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]},
        "legal": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]}
      }
    },
    "decision": {"const": "VALIDATE"},
    "authority_ceiling": {"const": "SOURCE_EVIDENCE_ONLY"},
    "non_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 12}},
    "product_signal_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
