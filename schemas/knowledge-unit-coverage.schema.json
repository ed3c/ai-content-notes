{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/knowledge-unit-coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "items"],
  "properties": {
    "schema_version": {"const": "knowledge-unit-coverage@1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["knowledge_unit_id", "disposition", "evidence_ids", "card_ids", "projection_ids", "reason"],
        "properties": {
          "knowledge_unit_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["CARD_MAPPED", "PROJECTION_MAPPED", "DEFERRED", "BLOCKED_WITH_K_CARD", "OMITTED"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "card_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "projection_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
