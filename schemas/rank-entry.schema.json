{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/rank-entry.schema.json",
  "title": "Open-source Artifact Rank Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "artifact_type",
    "canonical_url",
    "version",
    "digest",
    "licenses",
    "scores",
    "hard_gates",
    "compatibility",
    "evidence",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "rank-entry@1"
    },
    "id": {
      "type": "string",
      "pattern": "^asset:[a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "artifact_type": {
      "enum": [
        "code",
        "model",
        "data",
        "trajectory",
        "multi-plane"
      ]
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^(sha256:[a-f0-9]{64}|git-commit:[a-f0-9]{40})$"
    },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "model",
        "data",
        "trajectory"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/license"
        },
        "model": {
          "$ref": "#/$defs/license"
        },
        "data": {
          "$ref": "#/$defs/license"
        },
        "trajectory": {
          "$ref": "#/$defs/license"
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mvp_speed",
        "commercial_fit",
        "research_value",
        "production_readiness",
        "compatibility",
        "evidence"
      ],
      "properties": {
        "mvp_speed": {
          "$ref": "#/$defs/score"
        },
        "commercial_fit": {
          "$ref": "#/$defs/score"
        },
        "research_value": {
          "$ref": "#/$defs/score"
        },
        "production_readiness": {
          "$ref": "#/$defs/score"
        },
        "compatibility": {
          "$ref": "#/$defs/score"
        },
        "evidence": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "license",
        "security",
        "maintenance",
        "compatibility",
        "evidence"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/gate"
        },
        "license": {
          "$ref": "#/$defs/gate"
        },
        "security": {
          "$ref": "#/$defs/gate"
        },
        "maintenance": {
          "$ref": "#/$defs/gate"
        },
        "compatibility": {
          "$ref": "#/$defs/gate"
        },
        "evidence": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "languages",
        "runtimes",
        "deployment_targets"
      ],
      "properties": {
        "languages": {
          "$ref": "#/$defs/stringList"
        },
        "runtimes": {
          "$ref": "#/$defs/stringList"
        },
        "deployment_targets": {
          "$ref": "#/$defs/stringList"
        },
        "hosts": {
          "$ref": "#/$defs/stringList"
        },
        "hardware": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "sources",
        "last_verified_at",
        "stale_after"
      ],
      "properties": {
        "grade": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5",
            "E6"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "kind"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "kind": {
                "enum": [
                  "official-docs",
                  "official-source",
                  "release",
                  "license",
                  "security-advisory",
                  "benchmark",
                  "sandbox-receipt",
                  "production-observation"
                ]
              },
              "digest": {
                "type": "string"
              }
            }
          }
        },
        "last_verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "stale_after": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "enum": [
        "discovery",
        "candidate",
        "recommended-mvp",
        "recommended-commercial",
        "recommended-research",
        "recommended-production",
        "blocked",
        "deprecated",
        "invalidated"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not-applicable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not-applicable"
          ]
        },
        "identifier": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "obligations": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
