{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/multimodal-source-pack.schema.json",
  "title": "Multimodal source pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "content_id",
    "source_set_digest",
    "source_dependency_keys",
    "modalities",
    "artifacts",
    "authority",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "multimodal-source-pack@1"},
    "pack_id": {"type": "string", "minLength": 1},
    "content_id": {"type": "string", "minLength": 1},
    "source_set_digest": {"$ref": "#/$defs/sha256"},
    "source_dependency_keys": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "modalities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript", "video_frames", "visual_evidence", "audio", "metadata"],
      "properties": {
        "transcript": {"$ref": "#/$defs/modalityStatus"},
        "video_frames": {"$ref": "#/$defs/modalityStatus"},
        "visual_evidence": {"$ref": "#/$defs/modalityStatus"},
        "audio": {"$ref": "#/$defs/modalityStatus"},
        "metadata": {"$ref": "#/$defs/modalityStatus"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "modality",
          "role",
          "media_type",
          "digest",
          "path",
          "source_dependency_key",
          "primary_or_secondary"
        ],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "modality": {"enum": ["transcript", "video-frame", "visual-evidence", "audio", "metadata", "relation-graph", "projection"]},
          "role": {"enum": ["subject-matter-source", "derived-view", "audit-artifact", "evaluation-target", "candidate-output"]},
          "media_type": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/sha256"},
          "path": {"type": "string", "minLength": 1},
          "source_dependency_key": {"type": "string", "minLength": 1},
          "primary_or_secondary": {"enum": ["primary", "secondary", "derived"]},
          "locator_range": {"type": ["string", "null"]}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_compile_cards",
        "may_reconstruct_visuals",
        "may_treat_visual_text_as_source_exact",
        "may_complete_note",
        "may_publish_raw_media"
      ],
      "properties": {
        "may_compile_cards": {"type": "boolean"},
        "may_reconstruct_visuals": {"type": "boolean"},
        "may_treat_visual_text_as_source_exact": {"type": "boolean"},
        "may_complete_note": {"type": "boolean"},
        "may_publish_raw_media": {"type": "boolean"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "modalityStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["AVAILABLE", "PARTIAL", "BLOCKED", "NOT_REQUESTED"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
