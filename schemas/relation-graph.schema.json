{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/relation-graph.schema.json",
  "title": "Evidence-bound assertion and relation graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "source_pack_digest",
    "nodes",
    "edges",
    "thesis_ranking",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "relation-graph@1"},
    "graph_id": {"type": "string", "minLength": 1},
    "source_pack_digest": {"$ref": "#/$defs/sha256"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "label", "node_kind", "aliases", "evidence_ids", "visual_ids", "tags"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "node_kind": {"enum": ["entity", "event", "claim", "decision", "artifact", "card", "unknown", "state-plane"]},
          "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "visual_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation_id",
          "subject",
          "predicate",
          "object",
          "relation_kind",
          "claim_kind",
          "verification",
          "confidence",
          "evidence_ids",
          "visual_ids",
          "decision_use",
          "falsifier",
          "projection_hints",
          "uncertain"
        ],
        "properties": {
          "relation_id": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "object": {"type": "string", "minLength": 1},
          "relation_kind": {
            "enum": [
              "causes",
              "enables",
              "depends_on",
              "contradicts",
              "analogous_to",
              "implements",
              "validates",
              "flows_to",
              "instance_of",
              "supersedes",
              "mitigates",
              "part_of",
              "trades_off_with",
              "feeds",
              "transforms"
            ]
          },
          "claim_kind": {"enum": ["SOURCE_STATEMENT", "OBSERVATION", "INFERENCE", "HYPOTHESIS", "NORMATIVE"]},
          "verification": {"enum": ["UNCHECKED", "SUPPORTED", "CORROBORATED", "TESTED", "CONTESTED", "FALSIFIED"]},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "visual_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "decision_use": {"type": "string", "minLength": 1},
          "falsifier": {"type": "string", "minLength": 1},
          "projection_hints": {
            "type": "array",
            "items": {"enum": ["causal-dataflow", "comparison-matrix", "timeline", "state-planes", "equation", "architecture"]},
            "uniqueItems": true
          },
          "uncertain": {"type": "boolean"}
        }
      }
    },
    "thesis_ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "proposition", "relation_ids", "score", "score_breakdown"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "proposition": {"type": "string", "minLength": 1},
          "relation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "score_breakdown": {
            "type": "object",
            "additionalProperties": false,
            "required": ["causal_reach", "centrality", "source_recurrence", "decision_impact", "source_emphasis", "novelty", "evidence_strength"],
            "properties": {
              "causal_reach": {"type": "number", "minimum": 0, "maximum": 1},
              "centrality": {"type": "number", "minimum": 0, "maximum": 1},
              "source_recurrence": {"type": "number", "minimum": 0, "maximum": 1},
              "decision_impact": {"type": "number", "minimum": 0, "maximum": 1},
              "source_emphasis": {"type": "number", "minimum": 0, "maximum": 1},
              "novelty": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence_strength": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
