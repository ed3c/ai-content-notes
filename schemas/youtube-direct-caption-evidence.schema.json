{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/youtube-direct-caption-evidence.schema.json",
  "title": "No-cookie direct YouTube caption evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "status",
    "video",
    "authorization",
    "acquisition",
    "validation",
    "artifacts",
    "authority",
    "source_manifest_digest",
    "source_manifest_id",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "youtube-direct-caption-evidence@1"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "youtube_direct_caption_adapter.py"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "status": {"enum": ["needs-review", "blocked"]},
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "canonical_url", "title", "channel", "duration_seconds",
        "published_at"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{6,20}$"},
        "canonical_url": {"type": "string", "format": "uri"},
        "title": {"type": ["string", "null"]},
        "channel": {"type": ["string", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "published_at": {
          "anyOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "rights_basis", "rights_reference", "attested_by",
        "attested_at", "scope"
      ],
      "properties": {
        "status": {"enum": ["verified", "unverified-evaluation-only"]},
        "rights_basis": {
          "enum": [
            "owned", "licensed", "creator-permission", "public-domain",
            "user-provided-media", "user-directed-evaluation"
          ]
        },
        "rights_reference": {"type": "string", "minLength": 1},
        "attested_by": {"type": "string", "minLength": 1},
        "attested_at": {"type": "string", "format": "date-time"},
        "scope": {
          "enum": ["private-transient-evaluation", "review-candidate-evidence"]
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend", "backend_repository", "backend_version",
        "requested_languages", "language", "language_name", "caption_kind",
        "selection_outside_preference", "retrieved_at", "cookies_used",
        "proxy_used", "audio_used"
      ],
      "properties": {
        "backend": {"const": "youtube-transcript-api"},
        "backend_repository": {"const": "jdepoix/youtube-transcript-api"},
        "backend_version": {"const": "1.2.4"},
        "requested_languages": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "language": {"type": ["string", "null"]},
        "language_name": {"type": ["string", "null"]},
        "caption_kind": {"enum": ["manual", "automatic", null]},
        "selection_outside_preference": {"type": "boolean"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "cookies_used": {"const": false},
        "proxy_used": {"const": false},
        "audio_used": {"const": false}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_count", "word_count", "character_count", "timestamps_monotonic",
        "maximum_end_seconds", "warnings", "human_review_required"
      ],
      "properties": {
        "cue_count": {"type": "integer", "minimum": 0},
        "word_count": {"type": "integer", "minimum": 0},
        "character_count": {"type": "integer", "minimum": 0},
        "timestamps_monotonic": {"type": "boolean"},
        "maximum_end_seconds": {"type": "number", "minimum": 0},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "human_review_required": {"const": true}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256Bare"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_compile_evaluation_cards", "may_complete_note",
        "may_raise_claim_evidence", "may_enable_skill_routing"
      ],
      "properties": {
        "may_compile_evaluation_cards": {"const": true},
        "may_complete_note": {"const": false},
        "may_raise_claim_evidence": {"const": false},
        "may_enable_skill_routing": {"const": false}
      }
    },
    "source_manifest_digest": {
      "anyOf": [
        {"$ref": "#/$defs/sha256Prefixed"},
        {"type": "null"}
      ]
    },
    "source_manifest_id": {"type": ["string", "null"]},
    "error": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "needs-review"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "acquisition": {
            "properties": {
              "language": {"type": "string", "minLength": 1},
              "language_name": {"type": "string", "minLength": 1},
              "caption_kind": {"enum": ["manual", "automatic"]}
            }
          },
          "validation": {
            "properties": {
              "cue_count": {"minimum": 1},
              "timestamps_monotonic": {"const": true}
            }
          },
          "source_manifest_digest": {"$ref": "#/$defs/sha256Prefixed"},
          "source_manifest_id": {"type": "string", "minLength": 1},
          "error": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256Bare": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha256Prefixed": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
