{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/assertion-report-v7.1.schema.json",
  "title": "Zettelkasten v7.1 Assertion Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol", "prompt", "source_digest",
    "compiler_output_digest", "validator", "quality_gates", "summary",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "zettelkasten-assertion-report@2"},
    "protocol": {"const": "zettelkasten-v7.1-evidence-first-narrative-alive-dual-plane"},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_sha1"],
      "properties": {
        "path": {"const": "governance/CARD_PROTOCOL_V7_1.md"},
        "git_blob_sha1": {"const": "7f3019f4b41a90728cd48a523d742c7c59721bf6"}
      }
    },
    "source_digest": {"$ref": "#/$defs/sha256"},
    "compiler_output_digest": {"$ref": "#/$defs/sha256"},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "mode": {"enum": ["deterministic", "runtime", "human-review", "hybrid"]}
      }
    },
    "quality_gates": {
      "type": "object",
      "minProperties": 24,
      "maxProperties": 24,
      "additionalProperties": false,
      "patternProperties": {
        "^QG-(0[1-9]|1[0-9]|2[0-4])$": {"$ref": "#/$defs/gateState"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "not_run", "hard_gate_failures"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0, "maximum": 24},
        "fail": {"type": "integer", "minimum": 0, "maximum": 24},
        "not_run": {"type": "integer", "minimum": 0, "maximum": 24},
        "hard_gate_failures": {"type": "array", "items": {"type": "string", "pattern": "^QG-(0[1-9]|1[0-9]|2[0-4])$"}, "uniqueItems": true}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "gateState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "failures"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(artifact|assertion|card|eval|registry|source|validator):.+$"},
          "uniqueItems": true
        },
        "failures": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {"properties": {"evidence": {"minItems": 1}, "failures": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"status": {"const": "FAIL"}}, "required": ["status"]},
          "then": {"properties": {"failures": {"minItems": 1}}}
        }
      ]
    }
  }
}
