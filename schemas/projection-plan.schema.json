{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/projection-plan.schema.json",
  "title": "Evidence-bound knowledge projection plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "source_graph_digest", "projections", "created_at"],
  "properties": {
    "schema_version": {"const": "projection-plan@1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "source_graph_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "projections": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
