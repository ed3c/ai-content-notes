{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/ai-content-notes/schemas/note-delta.schema.json",
  "title": "AI Content Note Delta Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_repository",
    "source_commit",
    "generated_by",
    "changed_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "ai-content-note-delta@1"
    },
    "source_repository": {
      "const": "ed3c/ai-content-notes"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "generated_by": {
      "const": "tools/export_note_delta.py"
    },
    "changed_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/noteDelta"
      }
    }
  },
  "$defs": {
    "noteDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path",
        "blob_sha",
        "claim_map_path",
        "source_url",
        "domain",
        "terms",
        "claim_ids",
        "capability_ids",
        "engineering_lifecycle",
        "principle_ids",
        "artifact_planes",
        "skill_impact",
        "readback_verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "path": {
          "type": "string",
          "pattern": "^notes/[a-z0-9-]+/.+\\.md$"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "claim_map_path": {
          "type": "string",
          "pattern": "^(examples|claim-maps)/.+\\.claim-map\\.json$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "domain": {
          "type": "string"
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^claim:[a-z0-9._-]+$"
          }
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
          }
        },
        "engineering_lifecycle": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "discover",
              "learn",
              "specify",
              "design",
              "implement",
              "verify",
              "secure",
              "deploy",
              "operate",
              "observe",
              "migrate",
              "retire"
            ]
          }
        },
        "principle_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "artifact_planes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "code",
              "model",
              "data",
              "trajectory"
            ]
          }
        },
        "skill_impact": {
          "const": "review-and-requalify"
        },
        "readback_verified": {
          "const": true
        }
      }
    }
  }
}
